INCONCERT_USER=
INCONCERT_PASSWORD=
GOOGLE_SHEET_ID=

# Usar "service_account" si se comparte un JSON de cuenta de servicio por canal seguro.
# Usar "oauth" si cada usuario autenticara su propia cuenta de Google.
GOOGLE_AUTH_MODE=service_account

GOOGLE_CREDENTIALS_PATH=./config/data/google_credentials.json
GOOGLE_OAUTH_CLIENT_SECRET_PATH=./config/data/google_oauth_client_secret.json
GOOGLE_OAUTH_TOKEN_PATH=./config/data/google_oauth_token.json
LEAD_TIMEOUT_SECONDS=120
MAX_WORKERS=3
PORT=8000
