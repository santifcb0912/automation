# ============================================================
# .gitignore
# Archivos que NUNCA deben subirse a git
# Contienen contraseñas y datos sensibles
# ============================================================

# Archivo con todas tus contraseñas — NUNCA a git
.env

# Credenciales de Google — contiene clave privada RSA
config/google_credentials.json
config/google_oauth_client_secret.json
config/google_oauth_token.json

# Capturas de pantalla temporales
screenshots/

# Archivos de log
logs/

# Entorno virtual de Python
venv/
env/
xlr8/

# Archivos compilados de Python — se generan automáticamente
__pycache__/
*.pyc
*.pyo
*.pyd

# Archivos del sistema Windows
Thumbs.db
desktop.ini

# Archivos de IDEs
.vscode/
.idea/
*.suo
*.user

# Paquetes generados para compartir
*.zip
