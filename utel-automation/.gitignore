# ============================================================
# .gitignore
# Archivos que NUNCA deben subirse a git
# Contienen contraseñas y datos sensibles
# ============================================================

# Archivo con todas las contraseñas — NUNCA a git
.env

# Credenciales de Google — contiene clave privada RSA
config/data/google_credentials.json
config/data/google_oauth_client_secret.json
config/data/google_oauth_token.json

# Perfil persistente de Chrome
chrome_profile/

# Archivos de log
logs/

# Entorno virtual de Python
venv/
env/

# Archivos compilados de Python — se generan automáticamente
__pycache__/
*.pyc
*.pyo
*.pyd

# Archivos del sistema Windows
Thumbs.db
desktop.ini

# Archivos de IDEs
.vscode/
.idea/
*.suo
*.user

# Paquetes generados para compartir
*.zip

